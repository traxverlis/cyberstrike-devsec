# .env.example — Variables d'environnement pour le mode Docker
# Copier vers .env et remplir les valeurs

# Chemin du projet à scanner (défaut: répertoire courant)
PROJECT_PATH=.

# Dossier de sortie des rapports (défaut: ./security-reports)
REPORTS_PATH=./security-reports

# Dossier des consentements Level 2/3
CONSENTS_PATH=./reports/consent

# Chemin vers config.yaml pour l'IA
CONFIG_PATH=./config.yaml

# GitHub Copilot (pour --ai)
# Récupérer avec : ./scripts/copilot-token.sh
GITHUB_COPILOT_TOKEN=

# OpenAI (alternatif à Copilot)
OPENAI_API_KEY=

# NVD API key (accélère les scans CVE grype/trivy)
# Obtenir sur : https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
